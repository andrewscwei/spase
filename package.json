{
  "name": "spase",
  "version": "13.1.0",
  "description": "Micro library for performing 2D spatial calculations of DOM elements",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./build/spase.umd.cjs",
  "module": "./build/spase.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/spase.js",
      "require": "./build/spase.umd.cjs"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "clean": "rimraf -g build coverage",
    "build": "npm run typecheck && vite build",
    "prepages": "rimraf .gh-pages",
    "pages": "vite build -c demo/vite.config.ts",
    "dev": "concurrently \"vite build -w \" \"wait-on build && vite dev -c demo/vite.config.ts --port 8080\"",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [
    "browser",
    "window",
    "viewport",
    "element",
    "dimension",
    "utility",
    "2d",
    "typescript",
    "rect"
  ],
  "author": "Andrew Wei <andrewscwei@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewscwei/spase.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/git": "^11.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "rimraf": "^6.1.4",
    "semantic-release": "^26.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.2",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
